# Cloudflare R2 (admin browse media uploads — local/dev only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public CDN base URL, no trailing slash (e.g. https://pub-xxx.r2.dev or custom domain)
R2_PUBLIC_URL=

# Supabase (auth + component metadata + copy events)
NEXT_PUBLIC_SUPABASE_URL=
# Prefer publishable key; anon key also works
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: admin metadata sync from filesystem writes
SUPABASE_SERVICE_ROLE_KEY=
